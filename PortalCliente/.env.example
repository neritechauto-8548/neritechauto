# Apenas no servidor Next.js. Nunca use NEXT_PUBLIC_ para tokens ou URL privada.
PORTAL_BACKEND_URL=http://localhost:8080

# Nenhum endpoint abaixo é considerado existente até ser implementado e
# homologado com autenticação própria do cliente, ownership e tenant no Spring.
# Rotas específicas, nunca /auth/login nem /public/ordem-servico/** (legados internos).
PORTAL_CUSTOMER_LOGIN_ENDPOINT=
PORTAL_CUSTOMER_HISTORY_ENDPOINT=
PORTAL_CUSTOMER_DETAIL_ENDPOINT=
PORTAL_CUSTOMER_APPROVE_ENDPOINT=
PORTAL_CUSTOMER_REVISION_ENDPOINT=

# Consulta reduzida requer código individual (ou prova equivalente) e anti-enumeration.
PORTAL_PUBLIC_LOOKUP_ENDPOINT=
PORTAL_PUBLIC_LOOKUP_ENABLED=false

# Usado somente para configurar a expiração máxima do cookie (<= token do backend).
PORTAL_SESSION_MAX_AGE_SECONDS=3600
